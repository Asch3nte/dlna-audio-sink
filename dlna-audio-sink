__version__ = "1.1.0"

SSDP_ADDR = "239.255.255.250"
SSDP_PORT = 1900
RENDERER_ST = "urn:schemas-upnp-org:device:MediaRenderer:1"
AVT = "urn:schemas-upnp-org:service:AVTransport:1"
CM = "urn:schemas-upnp-org:service:ConnectionManager:1"

# Bogus length advertised for the endless stream: large enough that no renderer
# reaches it, small enough to stay inside a signed 32-bit field.
FAKE_LENGTH = 0x7FFFFFF0

# States meaning "not playing". Renderers invent their own transitional names
# (LG_TRANSITIONING, TRANSITIONING...), so we only treat these as final.
IDLE_STATES = {"STOPPED", "NO_MEDIA_PRESENT", "PAUSED_PLAYBACK"}

CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
    "dlna-audio-sink")

VERBOSE = False


def log(*a) -> None:
    print(time.strftime("[%H:%M:%S]"), *a, flush=True)


def debug(*a) -> None:
    if VERBOSE:
        print(time.strftime("[%H:%M:%S]"), "debug:", *a, flush=True)


def die(msg: str, hint: str = "") -> None:
    print(f"error: {msg}", file=sys.stderr)
    if hint:
        print(f"hint:  {hint}", file=sys.stderr)
    sys.exit(1)


# --------------------------------------------------------------------------
# Audio formats
# --------------------------------------------------------------------------

class Format:
    """An encoding we can offer to a renderer.

    `mime_match` is the prefix we look for in the renderer's advertised sink
    protocols; `content_type` is what we actually send back.
    """

    def __init__(self, name, mime_match, content_type, dlna_pn, encoder_args,
                 lossless):
        self.name = name
        self.mime_match = mime_match
        self.content_type = content_type
        self.dlna_pn = dlna_pn
        self.encoder_args = encoder_args
        self.lossless = lossless

    def __repr__(self):
        return f"<Format {self.name}>"


def build_formats(rate: int, channels: int, bitrate: str):
    """Candidate encodings, best quality first."""
    return [
        Format("flac", "audio/flac", "audio/flac", "FLAC",
               ["-c:a", "flac", "-f", "flac"], True),
        Format("lpcm", "audio/l16",
               f"audio/L16;rate={rate};channels={channels}", "LPCM",
               ["-f", "s16be", "-ar", str(rate), "-ac", str(channels)], True),
        Format("wav", "audio/wav", "audio/wav", None,
               ["-f", "wav"], True),
        Format("mp3", "audio/mpeg", "audio/mpeg", "MP3",
               ["-c:a", "libmp3lame", "-b:a", bitrate, "-f", "mp3"], False),
    ]


FORMAT_NAMES = ["flac", "lpcm", "wav", "mp3"]


