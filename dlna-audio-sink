SSDP_ADDR = "239.255.255.250"
SSDP_PORT = 1900
RENDERER_ST = "urn:schemas-upnp-org:device:MediaRenderer:1"
AVT = "urn:schemas-upnp-org:service:AVTransport:1"
CM = "urn:schemas-upnp-org:service:ConnectionManager:1"

# Bogus length advertised for the endless stream: large enough that no renderer
# reaches it, small enough to stay inside a signed 32-bit field.
FAKE_LENGTH = 0x7FFFFFF0

# States meaning "not playing". Renderers invent their own transitional names
# (LG_TRANSITIONING, TRANSITIONING...), so we only treat these as final.
IDLE_STATES = {"STOPPED", "NO_MEDIA_PRESENT", "PAUSED_PLAYBACK"}

# A renderer that has accepted nothing for this long is not coming back on
# this connection. The number that matters most in this file: without it, a
# stalled reader blocks the write, the encoder's pipe fills, and it stops
# draining the audio monitor - network backpressure reaching the sound graph.
CLIENT_SEND_TIMEOUT = 10.0
# Reading a request line has to be bounded too, or a peer that connects and
# says nothing keeps a thread for ever.
CLIENT_READ_TIMEOUT = 20.0
# An encoder producing nothing for this long is dead, whatever it claims.
CAPTURE_READ_TIMEOUT = 10.0
# Concurrent streams we are willing to serve. One renderer needs one.
MAX_STREAM_CLIENTS = 4
# Device descriptions are a few kilobytes; anything larger is not one.
MAX_DESCRIPTION_BYTES = 512 * 1024
# Same for SOAP answers: a transport state is a few hundred bytes.
MAX_SOAP_BYTES = 256 * 1024

# Failed restarts we tolerate before deciding the renderer is really gone and
# the sink has to go with it, and how often we then look for it to come back.
UNREACHABLE_BEFORE_TEARDOWN = 3
OFFLINE_POLL = 30.0

