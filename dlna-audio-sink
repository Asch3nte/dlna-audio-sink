def run(cmd, timeout: float = 10.0, **kw) -> subprocess.CompletedProcess:
    """Run a helper, and come back whatever happens.

    Everything here shells out to pactl, including the watchdog thread. A
    sound server that stops answering must cost us one call, not the thread
    that was supposed to notice the trouble - so a stall is reported as a
    failed command rather than left to hang.
    """
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=timeout, **kw)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(
            cmd, 1, "", f"'{cmd[0]}' did not answer within {timeout:g}s")
    except OSError as e:
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def audio_server_ok() -> tuple[bool, str]:
    """True if pactl can actually talk to a sound server."""
    if not shutil.which("pactl"):
        return False, "pactl not found"
    r = run(["pactl", "info"])
    if r.returncode != 0:
        return False, (r.stderr or r.stdout).strip().splitlines()[0] \
            if (r.stderr or r.stdout).strip() else "pactl info failed"
    return True, ""


def ffmpeg_has_pulse() -> bool:
    r = run(["ffmpeg", "-hide_banner", "-devices"])
    return bool(re.search(r"^\s*D.*\bpulse\b", r.stdout or "", re.M))


def list_sources() -> list[tuple[str, str]]:
    r = run(["pactl", "list", "sources"])
    out, name, desc = [], None, None
    for line in (r.stdout or "").splitlines():
        line = line.strip()
        if line.startswith("Name:"):
            name = line.split(":", 1)[1].strip()
        elif line.startswith("Description:"):
            desc = line.split(":", 1)[1].strip()
            if name:
                out.append((name, desc or ""))
                name = desc = None
    return out


def source_exists(name: str) -> bool:
    return any(n == name for n, _ in list_sources())


def sanitize(name: str) -> str:
    s = re.sub(r"[^A-Za-z0-9_.-]+", "-", name).strip("-_.")
    s = re.sub(r"-{2,}", "-", s)
    if not s or not re.match(r"[A-Za-z_]", s):
        s = "dlna-" + s if s else "dlna-sink"
    return s[:60]


class NullSink:
    """A PipeWire/PulseAudio null sink whose monitor we capture."""

    def __init__(self, name: str, description: str, rate: int, channels: int):
        self.name = name
        self.description = description
        self.rate = rate
        self.channels = channels
        self.module: str | None = None   # set only if *we* created it
        self.reused = False

    def _find_module(self) -> str | None:
        r = run(["pactl", "list", "short", "modules"])
        for line in (r.stdout or "").splitlines():
            parts = line.split("\t")
            if len(parts) >= 3 and f"sink_name={self.name}" in parts[2]:
                return parts[0]
        return None

    def _sink_id(self) -> str | None:
        r = run(["pactl", "list", "short", "sinks"])
        for line in (r.stdout or "").splitlines():
            parts = line.split("\t")
            if len(parts) >= 2 and parts[1] == self.name:
                return parts[0]
        return None

    def _default_sink(self) -> str | None:
        # get-default-sink prints the name and nothing else. Parsing the
        # "Default Sink:" line of `pactl info` would work here and quietly
        # stop working under a translated locale, taking the ability to move
        # streams anywhere with it.
        r = run(["pactl", "get-default-sink"])
        name = (r.stdout or "").strip()
        if r.returncode != 0 or not name:
            return None
        return name if name != self.name else None

    def release_clients(self) -> list[str]:
        """Hand anything playing here back to the default sink.

        Unloading the module with streams still attached leaves the server to
        re-route them after the fact. A client does not necessarily cope with
        its sink vanishing underneath it mid-stream, and when it does not the
        damage is silent: the process stays up, its stream stays listed, and
        only the far end notices that nothing is being consumed any more.

        Moving them first is the same thing the user would do by hand, in the
        order the client expects, and it costs one pactl call per stream. We
        do it whenever the sink is about to go, whoever asked for it.
        """
        sink_id = self._sink_id()
        target = self._default_sink()
        if sink_id is None or target is None:
            return []
        moved = []
        r = run(["pactl", "list", "short", "sink-inputs"])
        for line in (r.stdout or "").splitlines():
            parts = line.split("\t")
            if len(parts) >= 2 and parts[1] == sink_id:
                run(["pactl", "move-sink-input", parts[0], target])
                moved.append(parts[0])
        if moved:
            log(f"moved {len(moved)} stream(s) to '{target}' before removing "
                f"the sink")
        return moved

    def reclaim_clients(self, streams: list[str]) -> None:
        """Bring back the streams that were playing here before it went.

        Losing the renderer should cost the listener the renderer, not their
        choice of output: an application parked on this sink belongs here
        once it exists again. Best effort by design - a stream that ended or
        whose client restarted in the meantime is simply skipped, and pactl
        says so without us having to check first.
        """
        if not streams or self._sink_id() is None:
            return
        back = [s for s in streams
                if run(["pactl", "move-sink-input", s, self.name]).returncode == 0]
        if back:
            log(f"returned {len(back)} stream(s) to '{self.name}'")

    def create(self, force: bool = False, fatal: bool = True) -> bool:
        existing = self._find_module()
        if existing and force:
            log(f"unloading stale sink module {existing}")
            self.release_clients()
            run(["pactl", "unload-module", existing])
            existing = None
        if existing:
            log(f"sink '{self.name}' already exists, reusing it "
                "(use --force-sink to recreate)")
            self.reused = True
            return True
        # device.description is parsed by the server as a shell-ish token:
        # quote it so names with spaces or apostrophes survive.
        # audio.rate pins the node's rate. Without it PipeWire renegotiates
        # the sink when a client of another rate connects (a 96 kHz track, say),
        # which restarts our capture mid-stream and leaves the renderer running
        # seconds behind, with nothing to ever catch it up again.
        props = (f"device.description={shlex.quote(self.description)} "
                 f"audio.rate={self.rate}")
        r = run(["pactl", "load-module", "module-null-sink",
                 f"sink_name={self.name}",
                 f"sink_properties={props}",
                 f"rate={self.rate}", f"channels={self.channels}"])
        if r.returncode != 0:
            detail = (r.stderr or r.stdout).strip()
            if not fatal:
                log(f"could not recreate the audio sink: {detail}")
                return False
            die(f"could not create the audio sink: {detail}",
                "is PipeWire or PulseAudio running for this user?")
        self.module = (r.stdout or "").strip()
        log(f"sink '{self.name}' created (module {self.module})")
        return True

    def destroy(self) -> None:
        if self.module:
            self.release_clients()
            run(["pactl", "unload-module", self.module])
            debug(f"sink module {self.module} unloaded")
            self.module = None

    def teardown(self) -> list[str]:
        """Remove the sink even if we adopted it from an earlier run.

        destroy() is the shutdown path and deliberately leaves alone a
        module we did not load. This one runs when the renderer is gone,
        and then the sink is actively harmful whoever created it: clients
        keep being routed into a monitor nobody drains any more. So the
        module goes either way, and create() can put it back later.
        """
        module = self.module or self._find_module()
        if not module:
            return []
        moved = self.release_clients()
        run(["pactl", "unload-module", module])
        log(f"sink '{self.name}' removed (module {module})")
        self.module = None
        self.reused = False
        return moved

    @property
    def monitor(self) -> str:
        return f"{self.name}.monitor"


