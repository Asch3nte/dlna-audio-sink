class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Refuse redirects.

    We only ever talk to a device that answered our own search, on the
    address it answered from. A redirect would let it hand that check to
    somebody else's address after the fact.
    """

    def redirect_request(self, *a, **kw):
        return None


_opener = urllib.request.build_opener(_NoRedirect)


def _read_capped(resp, limit: int, what: str,
                 deadline: float = 30.0) -> bytes | None:
    """Read a bounded body, bounded in time as well as in size.

    A socket timeout only bounds one recv. A peer that dribbles a byte every
    few seconds never trips it and holds the caller for as long as it likes -
    and the caller here is the watchdog thread, the one thing that is
    supposed to notice trouble. So the whole read gets a wall clock too.
    """
    end = time.monotonic() + deadline
    chunks, total = [], 0
    while total <= limit:
        if time.monotonic() > end:
            debug(f"{what} still arriving after {deadline:g}s, ignored")
            return None
        piece = resp.read(min(65536, limit + 1 - total))
        if not piece:
            return b"".join(chunks)
        chunks.append(piece)
        total += len(piece)
    debug(f"{what} exceeds {limit} bytes, ignored")
    return None


def _tag(el) -> str:
    return el.tag.split("}", 1)[-1]


def fetch_xml(url: str, timeout: float, limit: int = MAX_DESCRIPTION_BYTES):
    """Fetch and parse a document some other machine told us about.

    Anything on the network can answer an SSDP search, so this URL is
    attacker-controlled and gets treated as such: only http(s), so a crafted
    reply cannot make us read local files through file:// or ftp://; a size
    cap, so it cannot hand us an endless body; and no DTD, because
    ElementTree happily expands entities and a few lines of XML can turn
    into gigabytes of memory.
    """
    parts = urllib.parse.urlsplit(url)
    if parts.scheme not in ("http", "https"):
        debug(f"refusing non-http description URL: {url!r}")
        return None
    try:
        with _opener.open(url, timeout=timeout) as resp:
            raw = _read_capped(resp, limit, f"description at {url}")
    except Exception as e:
        debug(f"description {url}: {type(e).__name__}: {e}")
        return None
    if raw is None:
        return None
    upper = raw[:8192].upper()
    if b"<!DOCTYPE" in upper or b"<!ENTITY" in upper:
        debug(f"description at {url} carries a DTD, ignored")
        return None
    try:
        return ET.fromstring(raw)
    except ET.ParseError as e:
        debug(f"malformed description at {url}: {e}")
        return None


class Renderer:
    def __init__(self, location: str):
        self.location = location
        parts = urllib.parse.urlsplit(location)
        self.base = f"{parts.scheme}://{parts.netloc}"
        self.host = parts.hostname or ""
        self.name = "?"
        self.manufacturer = ""
        self.model = ""
        self.udn = ""
        self.services: dict[str, str] = {}
        self._protocols: set[str] | None = None

    @classmethod
    def from_location(cls, location: str, timeout: float = 6.0):
        r = cls(location)
        root = fetch_xml(location, timeout)
        if root is None:
            return None

        # <URLBase>, when present, overrides the location's base (UPnP 1.0).
        for el in root:
            if _tag(el) == "URLBase" and (el.text or "").strip():
                r.base = (el.text or "").strip().rstrip("/")

        dev = next((el for el in root.iter() if _tag(el) == "device"), None)
        if dev is None:
            return None
        for el in dev:
            t, txt = _tag(el), (el.text or "").strip()
            if t == "friendlyName" and txt:
                r.name = txt
            elif t == "manufacturer":
                r.manufacturer = txt
            elif t == "modelName":
                r.model = txt
            elif t == "UDN":
                r.udn = txt

        for svc in root.iter():
            if _tag(svc) != "service":
                continue
            stype = ctrl = None
            for c in svc:
                if _tag(c) == "serviceType":
                    stype = (c.text or "").strip()
                elif _tag(c) == "controlURL":
                    ctrl = (c.text or "").strip()
            if stype and ctrl:
                r.services[stype] = urllib.parse.urljoin(r.base + "/", ctrl)

        if AVT not in r.services:
            debug(f"{r.name}: no AVTransport service, ignored")
            return None
        if not r.udn:
            r.udn = r.location
        return r

    # -- SOAP -------------------------------------------------------------
    def soap(self, service: str, action: str, body: str = "",
             timeout: float = 20.0) -> str:
        env = ('<?xml version="1.0"?><s:Envelope '
               'xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" '
               's:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">'
               f'<s:Body><u:{action} xmlns:u="{service}">{body}'
               f'</u:{action}></s:Body></s:Envelope>')
        req = urllib.request.Request(
            self.services[service], data=env.encode(), headers={
                "Content-Type": 'text/xml; charset="utf-8"',
                "SOAPAction": f'"{service}#{action}"',
                "User-Agent": f"dlna-audio-sink/{__version__}"})
        with _opener.open(req, timeout=timeout) as resp:
            raw = _read_capped(resp, MAX_SOAP_BYTES,
                               f"{action} answer from {self.host}")
        if raw is None:
            raise ValueError(f"{action}: answer too large")
        return raw.decode("utf-8", "replace")

    def avt(self, action: str, body: str = "", timeout: float = 20.0) -> str:
        return self.soap(AVT, action, f"<InstanceID>0</InstanceID>{body}",
                         timeout)

    # -- capabilities -----------------------------------------------------
    def protocols(self) -> set[str]:
        """Lower-cased audio MIME types the renderer claims it can sink."""
        if self._protocols is not None:
            return self._protocols
        found: set[str] = set()
        if CM in self.services:
            try:
                r = self.soap(CM, "GetProtocolInfo", timeout=10)
                m = re.search(r"<Sink>(.*?)</Sink>", r, re.S)
                for entry in html.unescape(m.group(1) if m else r).split(","):
                    parts = entry.split(":")
                    if len(parts) >= 3 and parts[2].lower().startswith("audio/"):
                        found.add(parts[2].strip().lower())
            except Exception as e:
                debug(f"{self.name}: GetProtocolInfo failed: {type(e).__name__}")
        self._protocols = found
        return found

    def advertised_rates(self) -> list[int]:
        """Sample rates the device lists for L16, best first.

        L16 carries its rate in the MIME type, so a device that only lists
        44100 will not take anything else. Formats that carry the rate in-band
        (FLAC, WAV) are not constrained this way.
        """
        rates = set()
        for p in self.protocols():
            if p.startswith("audio/l16"):
                m = re.search(r"rate=(\d+)", p)
                if m:
                    rates.add(int(m.group(1)))
        return sorted(rates, reverse=True)

    def advertised_channels(self) -> list[int]:
        """Channel counts the device lists for L16, best first."""
        chans = set()
        for p in self.protocols():
            if p.startswith("audio/l16"):
                m = re.search(r"channels=(\d+)", p)
                if m:
                    chans.add(int(m.group(1)))
        return sorted(chans, reverse=True)

    def advertises(self, fmt: Format) -> bool:
        """Whether the device lists this format.

        An empty list means it refused to tell us; we then let the probe
        decide rather than ruling anything out.
        """
        protos = self.protocols()
        if not protos:
            return True
        return any(p.startswith(fmt.mime_match) for p in protos)

    def transport_state(self) -> str:
        try:
            r = self.avt("GetTransportInfo", timeout=10)
            m = re.search(r"<CurrentTransportState>([^<]*)", r)
            return m.group(1).strip() if m else "?"
        except Exception as e:
            debug(f"GetTransportInfo: {type(e).__name__}")
            return "?"

    def stop(self) -> None:
        try:
            self.avt("Stop", timeout=8)
        except Exception:
            pass

    def play_url(self, url: str, fmt: Format, title: str) -> None:
        proto = f"http-get:*:{fmt.content_type}:"
        proto += f"DLNA.ORG_PN={fmt.dlna_pn}" if fmt.dlna_pn else "*"
        didl = ('<DIDL-Lite '
                'xmlns="urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/" '
                'xmlns:dc="http://purl.org/dc/elements/1.1/" '
                'xmlns:upnp="urn:schemas-upnp-org:metadata-1-0/upnp/">'
                '<item id="1" parentID="0" restricted="1">'
                f'<dc:title>{html.escape(title)}</dc:title>'
                '<upnp:class>object.item.audioItem.musicTrack</upnp:class>'
                f'<res protocolInfo="{html.escape(proto)}">'
                f'{html.escape(url)}</res></item></DIDL-Lite>')
        self.stop()
        time.sleep(1)
        self.avt("SetAVTransportURI",
                 f"<CurrentURI>{html.escape(url)}</CurrentURI>"
                 f"<CurrentURIMetaData>{html.escape(didl)}</CurrentURIMetaData>")
        time.sleep(1)
        # A renderer that dislikes the stream often never answers Play at all,
        # so a timeout here is not fatal: the state poll decides.
        try:
            self.avt("Play", "<Speed>1</Speed>", timeout=12)
        except Exception as e:
            debug(f"Play did not answer: {type(e).__name__}")


def discover(timeout: float = 4.0) -> list[Renderer]:
    out, seen = [], set()
    for loc in ssdp_search(timeout):
        r = Renderer.from_location(loc)
        if r and r.udn not in seen:
            seen.add(r.udn)
            out.append(r)
    out.sort(key=lambda r: r.name.lower())
    return out


# --------------------------------------------------------------------------
# HTTP streaming
# --------------------------------------------------------------------------

class StreamState:
    def __init__(self, source: str, send_length: bool, rate: int,
                 channels: int, use_pulse: bool, prebuffer: float = 2.0,
                 token: str = "", allowed_ip: str = ""):
        # An unguessable path, and by default only the renderer's own address.
        # Without both, every machine on the network can listen to this
        # computer live, and any of them can cut the stream the renderer is
        # playing simply by asking for it.
        self.token = token
        self.allowed_ip = allowed_ip
        self.slots = threading.BoundedSemaphore(MAX_STREAM_CLIENTS)
        self.source = source
        self.send_length = send_length
        self.rate = rate
        self.channels = channels
        self.use_pulse = use_pulse
        self.prebuffer = prebuffer
        self.fmt: Format | None = None
        self.connections = 0          # total, ever - used to detect firewalls
        self.last_error = ""
        self.current: Capture | None = None
        self.bytes_sent = 0           # since the last (re)start of the stream
        self.active = 0               # connections currently being served
        self.last_activity = 0.0
        self.lock = threading.Lock()

    def reset_stream_accounting(self) -> None:
        with self.lock:
            self.bytes_sent = 0


class StreamServer(ThreadingHTTPServer):
    """The HTTP side, with the noise a hostile peer can make bounded.

    socketserver prints a full traceback for any exception escaping a
    handler. A reset connection is routine here - renderers drop the stream
    all the time - and printing a stack trace for each one hands anyone who
    can reach the port a way to fill the journal.
    """

    daemon_threads = True
    allow_reuse_address = True

    def handle_error(self, request, client_address):
        debug(f"connection from {client_address[0]}: {sys.exc_info()[1]!r}")


def make_handler(state: StreamState):
    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        # Bounded, so a peer that connects and never speaks cannot keep a
        # thread. Re-armed to a shorter value once we start writing.
        timeout = CLIENT_READ_TIMEOUT

        def authorised(self) -> bool:
            if not state.token:          # jamais d'accès sans capability
                return False
            # Bytes, not str: the request line arrives as latin-1 and
            # compare_digest raises TypeError on anything non-ASCII, which
            # would hand a peer a crash for the price of one odd character.
            path = urllib.parse.urlsplit(self.path).path
            want = f"/stream/{state.token}".encode()
            if not hmac.compare_digest(path.encode("utf-8", "replace"), want):
                return False
            if state.allowed_ip and self.client_address[0] != state.allowed_ip:
                log(f"refused {self.client_address[0]}: expected the "
                    f"renderer at {state.allowed_ip} "
                    f"(--allow-any-client to permit it)")
                return False
            return True

        def log_message(self, *a):
            debug(f"{self.command} {self.path} <- {self.client_address[0]}")

        def _send_headers(self):
            fmt = state.fmt
            self.send_response(200)
            self.send_header("Content-Type", fmt.content_type)
            if state.send_length:
                self.send_header("Content-Length", str(FAKE_LENGTH))
            self.send_header("transferMode.dlna.org", "Streaming")
            feat = f"DLNA.ORG_PN={fmt.dlna_pn};" if fmt.dlna_pn else ""
            self.send_header(
                "contentFeatures.dlna.org",
                feat + "DLNA.ORG_OP=00;DLNA.ORG_CI=0;"
                "DLNA.ORG_FLAGS=01700000000000000000000000000000")
            self.send_header("Accept-Ranges", "none")
            self.end_headers()

        def do_HEAD(self):
            if not self.authorised():
                self.send_error(404)
                return
            if state.fmt is None:
                self.send_error(503)
                return
            try:
                self._send_headers()
            except (BrokenPipeError, ConnectionResetError):
                pass

        def do_GET(self):
            if not self.authorised():
                self.send_error(404)
                return
            fmt = state.fmt
            if fmt is None:
                self.send_error(503)
                return
            if not state.slots.acquire(blocking=False):
                log("refusing a stream: too many already open")
                self.send_error(503)
                return
            try:
                self.stream(fmt)
            finally:
                state.slots.release()

        def stream(self, fmt):
            if self.headers.get("Range"):
                # Live stream: position is meaningless. Renderers observed in
                # the wild send "bytes=0-" and accept a plain 200.
                debug(f"ignoring Range: {self.headers.get('Range')}")

            with state.lock:
                state.connections += 1
                state.active += 1
                state.bytes_sent = 0
                state.last_activity = time.time()
                # Only one stream at a time: a reconnecting renderer must not
                # leave an orphaned encoder running.
                cap = Capture(state.source, fmt, state.rate, state.channels,
                              state.use_pulse)
                previous, state.current = state.current, cap

            # Outside the lock on purpose: stop() waits on processes, and the
            # streaming loop below takes this same lock on every chunk.
            if previous is not None:
                debug("replacing the previous stream")
                previous.stop()

            try:
                self.serve_capture(fmt, cap)
            finally:
                # Every exit passes here. state.active is what tells the
                # watchdog whether anyone is listening; leaking it once is
                # enough to disable the "renderer stopped reading" check for
                # the rest of the run.
                self.close_connection = True
                with state.lock:
                    state.active -= 1
                    if state.current is cap:
                        state.current = None

        def serve_capture(self, fmt, cap):
            try:
                cap.start()
            except Exception as e:
                state.last_error = str(e)
                log(f"capture failed to start: {e}")
                try:
                    self.send_error(500)
                except Exception:
                    pass
                return

            try:
                self._send_headers()
            except (BrokenPipeError, ConnectionResetError):
                cap.stop()
                return

            # From here on, a peer that stops accepting data costs us this
            # connection and nothing more. Without a send timeout the write
            # blocks for ever, the encoder's pipe fills behind it, and the
            # encoder stops draining the audio monitor: a stalled television
            # reaching all the way into the sound graph of this machine.
            self.connection.settimeout(CLIENT_SEND_TIMEOUT)

            log(f"streaming {fmt.name} to {self.client_address[0]}")
            sent = 0
            sel = selectors.DefaultSelector()
            sel.register(cap.stdout, selectors.EVENT_READ)

            def pull(size: int = 16384) -> bytes:
                """A chunk from the encoder, b"" once it has gone quiet.

                A blocking read here would be the same trap in the other
                direction: an encoder that stops producing - device busy,
                process wedged - would hold this thread for ever, and with
                it the capture slot the renderer needs.
                """
                if not sel.select(CAPTURE_READ_TIMEOUT):
                    debug(f"encoder produced nothing for "
                          f"{CAPTURE_READ_TIMEOUT:g}s")
                    return b""
                return cap.stdout.read(size) or b""

            # We can only ever produce in real time, so a renderer that reads
            # as fast as we write never builds any reserve: it plays with an
            # almost empty buffer and the smallest hiccup - scheduler, GIL,
            # Wi-Fi jitter - empties it and you hear a gap. Hand it a cushion
            # up front, the way an Icecast server bursts on connect. It costs
            # exactly this much extra delay, and buys that much tolerance.
            if state.prebuffer > 0:
                cushion, until = [], time.time() + state.prebuffer
                while time.time() < until:
                    c = pull()
                    if not c:
                        break
                    cushion.append(c)
                try:
                    for c in cushion:
                        self.wfile.write(c)
                        sent += len(c)
                    debug(f"prebuffered {sent} bytes "
                          f"({state.prebuffer:.1f}s cushion)")
                except (BrokenPipeError, ConnectionResetError, TimeoutError):
                    sel.close()
                    cap.stop()
                    return

            try:
                while True:
                    chunk = pull()
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    sent += len(chunk)
                    with state.lock:
                        state.bytes_sent += len(chunk)
                        state.last_activity = time.time()
            except (BrokenPipeError, ConnectionResetError):
                debug(f"client closed the stream after {sent} bytes")
            except TimeoutError:
                log(f"{self.client_address[0]} stopped reading after "
                    f"{sent} bytes; dropping it rather than stalling capture")
            except Exception as e:
                debug(f"stream error: {type(e).__name__}: {e}")
            finally:
                sel.close()
                if sent == 0 and cap.died_early():
                    state.last_error = cap.failure_text() or "encoder exited"
                    log(f"capture produced nothing: {state.last_error}")
                cap.stop()
    return Handler


def source_ip_towards(host: str) -> str | None:
    """Local address the kernel would use to reach `host`.

    IPv4 is tried first: advertising an IPv6 URL while the HTTP server listens
    on 0.0.0.0 gives a renderer an address it can never connect to.
    """
    for family in (socket.AF_INET, socket.AF_INET6):
        try:
            infos = socket.getaddrinfo(host, 9, family, socket.SOCK_DGRAM)
        except OSError:
            continue
        for *_, sockaddr in infos:
            s = socket.socket(family, socket.SOCK_DGRAM)
            try:
                s.connect(sockaddr)
                return s.getsockname()[0]
            except OSError:
                continue
            finally:
                s.close()
    return None


def url_host(ip: str) -> str:
    return f"[{ip}]" if ":" in ip else ip


# --------------------------------------------------------------------------
# Format negotiation
# --------------------------------------------------------------------------

def cache_file(udn: str) -> str:
    return os.path.join(CACHE_DIR, sanitize(udn) + ".format")


def remember_format(udn: str, name: str) -> None:
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(cache_file(udn), "w") as f:
            f.write(name)
    except OSError as e:
        debug(f"could not cache the format: {e}")


def recall_format(udn: str) -> str | None:
    try:
        with open(cache_file(udn)) as f:
            v = f.read().strip()
        return v if v in FORMAT_NAMES else None
    except OSError:
        return None


def negotiate(renderer: Renderer, state: StreamState, url: str, formats,
              title: str, probe_timeout: float, forced: bool) -> Format:
    """Try each candidate until the renderer really reaches PLAYING."""
    tried = []
    for fmt in formats:
        if not forced and not renderer.advertises(fmt):
            debug(f"{fmt.name}: not advertised, skipped")
            continue
        tried.append(fmt.name)
        log(f"trying {fmt.name}...")
        # Clear the previous attempt's error, or it aborts this one instantly.
        state.last_error = ""
        state.fmt = fmt
        try:
            renderer.play_url(url, fmt, title)
        except Exception as e:
            log(f"  {fmt.name}: the device rejected the request "
                f"({type(e).__name__})")
            continue

        started = time.time()
        state_seen = "?"
        while time.time() - started < probe_timeout:
            state_seen = renderer.transport_state()
            if state_seen == "PLAYING":
                log(f"  {fmt.name}: accepted")
                return fmt
            # Give it a few seconds before believing an idle state.
            if state_seen in IDLE_STATES and time.time() - started > 8:
                break
            if state.last_error:
                break
            time.sleep(2)
        log(f"  {fmt.name}: refused (state={state_seen})")
        renderer.stop()

    # Nothing worked: say why, as precisely as we can.
    if state.connections == 0:
        die("the renderer never connected to our stream",
            "a firewall is probably blocking the HTTP port. Allow inbound "
            "TCP from the device, or pick a fixed one with --port and open it.")
    if state.last_error:
        die(f"the audio capture failed: {state.last_error}",
            "check that the source exists (--list-sources) and that ffmpeg "
            "can read it.")
    die(f"the renderer refused every format ({', '.join(tried) or 'none'})",
        "try --no-content-length, or force one with --format mp3. "
        "Run with --verbose and please report the log.")


