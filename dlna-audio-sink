def cmd_list(args) -> int:
    log(f"scanning for DLNA renderers ({args.timeout:.0f}s)...")
    found = discover(args.timeout)
    if not found:
        print("\nNo MediaRenderer found.\n"
              "  - is the device powered on and on this network?\n"
              "  - SSDP needs UDP port 1900; check your firewall\n"
              "  - some Wi-Fi networks block multicast between clients\n"
              "  - try a longer scan: --timeout 10")
        return 1
    print(f"\n{len(found)} renderer(s):\n")
    for i, r in enumerate(found, 1):
        print(f"  [{i}] {r.name}")
        print(f"      host   : {r.host}")
        if r.manufacturer or r.model:
            print(f"      device : {(r.manufacturer + ' ' + r.model).strip()}")
        protos = sorted(r.protocols())
        print(f"      audio  : {', '.join(protos) if protos else '(not advertised)'}")
        print(f"      udn    : {r.udn}")
        print()
    print('Start one with:  dlna-audio-sink --renderer "<name or part of it>"')
    return 0


def cmd_list_sources(args) -> int:
    ok, why = audio_server_ok()
    if not ok:
        die(f"no usable sound server: {why}")
    srcs = list_sources()
    if not srcs:
        print("No audio source found.")
        return 1
    print(f"\n{len(srcs)} source(s):\n")
    for name, desc in srcs:
        kind = "monitor" if name.endswith(".monitor") else "input"
        print(f"  {name}")
        print(f"      {desc}  [{kind}]")
    print("\nCapture one with:  dlna-audio-sink --renderer X --source <name>")
    return 0


def pick_renderer(selector: str, timeout: float) -> Renderer:
    if selector.startswith(("http://", "https://")):
        r = Renderer.from_location(selector)
        if not r:
            die(f"no usable MediaRenderer at {selector}")
        return r
    found = discover(timeout)
    if not found:
        die("no MediaRenderer found on the network",
            "run --list to scan, and see its hints if nothing shows up.")
    if selector:
        low = selector.lower()
        matches = [r for r in found
                   if low in r.name.lower() or low in r.udn.lower()]
        if not matches:
            die(f"no renderer matches {selector!r}",
                "found: " + ", ".join(r.name for r in found))
        if len(matches) > 1:
            die(f"{selector!r} is ambiguous",
                "matches: " + ", ".join(r.name for r in matches))
        return matches[0]
    if len(found) > 1:
        die("several renderers found; choose one with --renderer",
            ", ".join(r.name for r in found))
    return found[0]


def cmd_run(args) -> int:
    if not shutil.which("ffmpeg"):
        die("ffmpeg is required but was not found in PATH",
            "install it with your package manager (apt install ffmpeg).")
    ok, why = audio_server_ok()
    if not ok:
        die(f"no usable sound server: {why}",
            "PipeWire or PulseAudio must be running for this user. Under "
            "systemd, the unit must run in the user session, not system-wide.")

    use_pulse = ffmpeg_has_pulse()
    if not use_pulse:
        if not (shutil.which("parec") or shutil.which("pw-record")):
            die("this ffmpeg lacks PulseAudio input and no fallback recorder "
                "is installed",
                "install pulseaudio-utils (parec) or pipewire-bin (pw-record).")
        debug("ffmpeg has no pulse input; falling back to parec/pw-record")

    renderer = pick_renderer(args.renderer or "", args.timeout)
    log(f"renderer: {renderer.name} ({renderer.host})")

    # Pick the sample rate before creating anything: the sink is pinned to it,
    # so the resampling happens once, in PipeWire, instead of twice.
    rate = args.rate
    if not rate:
        advertised = renderer.advertised_rates()
        rate = advertised[0] if advertised else 44100
        if advertised:
            log(f"sample rate: {rate} Hz (highest the device advertises)")
            if len(advertised) > 1:
                debug(f"device also accepts {advertised[1:]}")
        else:
            debug("device advertises no LPCM rate; defaulting to 44100 Hz")

    channels = args.channels
    if not channels:
        offered = renderer.advertised_channels()
        # Stereo when the device takes it; otherwise the most it will accept.
        channels = 2 if 2 in offered else (offered[0] if offered else 2)
        if offered and channels != 2:
            log(f"channels: {channels} (the device does not advertise stereo)")

    local_ip = args.local_ip or source_ip_towards(renderer.host)
    if not local_ip:
        die(f"cannot work out which local address reaches {renderer.host}",
            "set it explicitly with --local-ip.")
    debug(f"local address towards the renderer: {local_ip}")

    # Either capture an existing source, or make our own sink.
    sink = None
    if args.source:
        if not source_exists(args.source):
            die(f"no such audio source: {args.source}",
                "list them with --list-sources.")
        source = args.source
        label = args.source
        log(f"capturing existing source '{source}'")
        if not source.endswith(".monitor"):
            log("note: this is a capture device, not a monitor - it may be "
                "a microphone, and it will be reachable over the network")
    else:
        sink_name = args.sink_name or sanitize(renderer.name)
        label = args.description or renderer.name
        sink = NullSink(sink_name, label, rate, channels)
        sink.create(force=args.force_sink)
        source = sink.monitor

    # The stream carries whatever this machine is playing, so the URL is a
    # capability: unguessable, and by default usable only from the renderer
    # we are talking to. Anyone who can reach the port would otherwise be
    # able to listen in, and to cut the renderer's stream by asking for it.
    token = secrets.token_urlsafe(16)
    allowed = "" if args.allow_any_client else renderer.host
    if not allowed:
        log("note: --allow-any-client is set; any host that guesses the "
            "stream URL can listen")
    state = StreamState(source, send_length=not args.no_content_length,
                        rate=rate, channels=channels,
                        use_pulse=use_pulse, prebuffer=args.prebuffer,
                        token=token, allowed_ip=allowed)
    bind_addr = args.bind
    if ":" in local_ip:                       # IPv6 renderer
        if bind_addr == "0.0.0.0":
            bind_addr = "::"
        StreamServer.address_family = socket.AF_INET6
    try:
        httpd = StreamServer((bind_addr, args.port), make_handler(state))
    except OSError as e:
        if sink:
            sink.destroy()
        if e.errno == errno.EADDRINUSE:
            die(f"port {args.port} is already in use",
                "leave --port out to get a free one automatically.")
        die(f"cannot listen on {bind_addr}:{args.port}: {e}")
    httpd.daemon_threads = True
    port = httpd.server_address[1]
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    url = f"http://{url_host(local_ip)}:{port}/stream/{token}"
    # The token is a credential: the renderer gets it, the journal does not.
    log(f"serving http://{url_host(local_ip)}:{port}/stream/…")

    stopping = threading.Event()

    def on_signal(signum, _frame):
        # Only flip a flag here: doing network or subprocess work inside a
        # signal handler can deadlock.
        stopping.set()

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    def shutdown():
        log("shutting down")
        if state.current:
            state.current.stop()
        renderer.stop()
        if sink:
            sink.destroy()

    formats = build_formats(rate, channels, args.bitrate)
    forced = args.format != "auto"
    if forced:
        formats = [f for f in formats if f.name == args.format]
    else:
        remembered = recall_format(renderer.udn)
        if remembered:
            formats.sort(key=lambda f: f.name != remembered)
            debug(f"cached working format: {remembered}")

    try:
        fmt = negotiate(renderer, state, url, formats, args.title,
                        args.probe_timeout, forced)
    except SystemExit:
        if state.current:
            state.current.stop()
        if sink:
            sink.destroy()
        raise

    if not forced:
        remember_format(renderer.udn, fmt.name)
    if not fmt.lossless:
        log(f"note: {fmt.name} is lossy - the device refused every lossless "
            "candidate")
    log(f"ready - select '{label}' as your audio output")

    # Watchdog. Three distinct ways playback dies, all seen in practice:
    #
    #  * the renderer stops on its own (sleep, input change) -> idle state;
    #  * it keeps claiming to play while our stream is long gone -> no bytes;
    #  * it consumes the whole Content-Length we invented and treats the
    #    "file" as finished. At LPCM that budget is only about three hours,
    #    so we restart before it runs out rather than after.
    delay = args.watchdog
    not_playing = 0

    # A renderer that has gone away - switched off, asleep, dropped off the
    # network - must not leave its sink behind. PipeWire keeps accepting
    # clients on a sink whose monitor nobody drains any more, so anything
    # routed there stops dead while still looking perfectly healthy: the
    # stream shows up as running, the latency reads zero, and the player at
    # the other end wedges. module-stream-restore is happy to route a client
    # onto exactly this sink on its own, remembering a session from when the
    # device was still up. Unloading the module moves those clients back to
    # the default sink, which is where they would have been all along.
    offline = False
    unreachable = 0
    displaced: list[str] = []      # streams parked elsewhere while offline

    def go_offline(reason: str) -> None:
        nonlocal offline, unreachable, delay
        offline = True
        unreachable = 0
        delay = OFFLINE_POLL
        log(f"{reason}; removing the sink until the renderer is back")
        with state.lock:
            cap, state.current = state.current, None
        if cap:
            cap.stop()
        state.reset_stream_accounting()
        if sink:
            displaced.clear()
            displaced.extend(sink.teardown())

    def come_back(st: str) -> None:
        nonlocal offline, delay, not_playing
        if sink and not sink.create(force=True, fatal=False):
            return                      # sound server busy; try again later
        if sink:
            sink.reclaim_clients(displaced)
            displaced.clear()
        log(f"renderer answered again (state={st})")
        offline = False
        not_playing = 0
        delay = args.watchdog
        restart("resuming after the renderer came back")

    def restart(reason: str) -> bool:
        nonlocal delay, unreachable
        log(f"{reason}; restarting the stream")
        try:
            renderer.play_url(url, fmt, args.title)
            delay = args.watchdog
            unreachable = 0
            return True
        except Exception as e:
            unreachable += 1
            if not offline and unreachable >= UNREACHABLE_BEFORE_TEARDOWN:
                log(f"restart failed ({type(e).__name__})")
                go_offline(f"renderer unreachable after {unreachable} attempts")
                return False
            delay = min(delay * 2, 300)
            log(f"restart failed ({type(e).__name__}); retrying in "
                f"{delay:.0f}s")
            return False

    while not stopping.is_set():
        if stopping.wait(delay):
            break

        if offline:
            st = renderer.transport_state()
            if st != "?":
                come_back(st)
            continue

        with state.lock:
            sent = state.bytes_sent
            active = state.active
            quiet = time.time() - state.last_activity

        # Renew well before the renderer reaches the declared length.
        if sent > FAKE_LENGTH * 0.85:
            restart(f"approaching the declared stream length ({sent} bytes)")
            not_playing = 0
            continue

        st = renderer.transport_state()

        if st in IDLE_STATES:
            restart(f"renderer went to {st}")
            not_playing = 0
            continue

        # It says it is playing, but nothing is being read from us.
        if active == 0 and quiet > max(30.0, args.watchdog * 2):
            restart(f"no data read for {quiet:.0f}s while state={st}")
            not_playing = 0
            continue

        # Never reached PLAYING: a vendor state such as LG_TRANSITIONING can
        # stick forever, and waiting on an exact name would wait for ever too.
        if st != "PLAYING":
            not_playing += 1
            if not_playing >= 3:
                restart(f"stuck in state={st}")
                not_playing = 0
            continue

        not_playing = 0
        delay = args.watchdog

    shutdown()
    return 0


def main() -> int:
    global VERBOSE
    p = argparse.ArgumentParser(
        prog="dlna-audio-sink",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Use a DLNA/UPnP MediaRenderer (TV, AV receiver, speaker) "
                    "as a system audio output.",
        epilog="examples:\n"
               "  dlna-audio-sink --list\n"
               '  dlna-audio-sink --renderer "Living room TV"\n'
               "  dlna-audio-sink -r TV --source alsa_input.pci-0000_00_1f.3"
               ".analog-stereo\n")
    p.add_argument("--list", action="store_true",
                   help="scan the network and list renderers, then exit")
    p.add_argument("--list-sources", action="store_true",
                   help="list local audio sources, then exit")
    p.add_argument("-r", "--renderer", metavar="NAME",
                   help="renderer name (or part of it), UDN, or description URL")
    p.add_argument("--source", metavar="NAME",
                   help="capture this existing source instead of creating a "
                        "sink (a microphone, or another device's monitor)")
    p.add_argument("-f", "--format", default="auto",
                   choices=["auto"] + FORMAT_NAMES,
                   help="stream format (default: auto-negotiated)")
    p.add_argument("-b", "--bitrate", default="320k",
                   help="MP3 bitrate, when it falls back that far")
    p.add_argument("--rate", type=int, default=0,
                   help="sample rate (default: the best the device advertises)")
    p.add_argument("--channels", type=int, default=0,
                   help="channel count (default: what the device takes)")
    p.add_argument("--sink-name", help="PipeWire sink name")
    p.add_argument("--description", help="label shown in audio settings")
    p.add_argument("--force-sink", action="store_true",
                   help="recreate the sink even if one of that name exists")
    p.add_argument("--title", default="Computer audio",
                   help="track title shown on the renderer")
    p.add_argument("--port", type=int, default=0,
                   help="HTTP port (default: an ephemeral one)")
    p.add_argument("--bind", default="0.0.0.0", help="HTTP bind address")
    p.add_argument("--allow-any-client", action="store_true",
                   help="serve the stream to any host that has the URL, not "
                        "only the renderer (needed if it fetches from a "
                        "different address than it answers on)")
    p.add_argument("--local-ip", help="address the renderer should connect to")
    p.add_argument("--timeout", type=float, default=4.0,
                   help="SSDP discovery timeout")
    p.add_argument("--probe-timeout", type=float, default=25.0,
                   help="seconds to wait for a format to start playing")
    p.add_argument("--prebuffer", type=float, default=2.0,
                   help="seconds of audio handed to the renderer up front, so "
                        "a hiccup does not empty its buffer. Raise it if the "
                        "sound stutters, lower it for less delay (0 disables)")
    p.add_argument("--watchdog", type=float, default=20.0,
                   help="seconds between playback checks")
    p.add_argument("--no-content-length", action="store_true",
                   help="omit the bogus Content-Length (a few renderers need "
                        "it absent; most need it present)")
    p.add_argument("-v", "--verbose", action="store_true")
    p.add_argument("--version", action="version",
                   version=f"%(prog)s {__version__}")
    args = p.parse_args()
    VERBOSE = args.verbose

    if args.rate < 0 or args.channels < 0:
        die("--rate and --channels must be positive")
    if args.prebuffer < 0:
        die("--prebuffer cannot be negative")
    if args.list:
        return cmd_list(args)
    if args.list_sources:
        return cmd_list_sources(args)
    return cmd_run(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
