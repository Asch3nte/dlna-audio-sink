# Capture pipeline
# --------------------------------------------------------------------------

def channel_layout(channels: int) -> list[str]:
    """Explicit layout, so ffmpeg does not warn about guessing one."""
    name = {1: "mono", 2: "stereo", 4: "quad", 6: "5.1", 8: "7.1"}.get(channels)
    return ["-channel_layout", name] if name else []


class Capture:
    """ffmpeg (optionally fed by parec) turning a source into an encoded stream."""

    def __init__(self, source: str, fmt: Format, rate: int, channels: int,
                 use_pulse: bool):
        self.procs: list[subprocess.Popen] = []
        self.stdout = None
        self._errbuf: dict[int, collections.deque] = {}
        self._threads: list[threading.Thread] = []
        self.source = source
        self.fmt = fmt
        self.rate = rate
        self.channels = channels
        self.use_pulse = use_pulse

    def _watch_stderr(self, proc: subprocess.Popen, label: str) -> None:
        buf: collections.deque = collections.deque(maxlen=20)
        self._errbuf[id(proc)] = buf

        def pump():
            try:
                for raw in iter(proc.stderr.readline, b""):
                    line = raw.decode("utf-8", "replace").rstrip()
                    if line:
                        buf.append(line)
                        debug(f"{label}: {line}")
            except Exception:
                pass
        t = threading.Thread(target=pump, daemon=True)
        t.start()
        self._threads.append(t)

    def start(self) -> None:
        if self.use_pulse:
            cmd = ["ffmpeg", "-hide_banner", "-loglevel", "warning",
                   "-fflags", "nobuffer", "-f", "pulse"] + \
                channel_layout(self.channels) + ["-i", self.source] + \
                self.fmt.encoder_args + ["-"]
            debug("capture:", " ".join(shlex.quote(c) for c in cmd))
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                 stderr=subprocess.PIPE)
            self.procs = [p]
            self._watch_stderr(p, "ffmpeg")
            self.stdout = p.stdout
            return

        # ffmpeg without PulseAudio support: capture with parec/pw-record.
        recorder = shutil.which("parec") or shutil.which("pw-record")
        if not recorder:
            raise RuntimeError(
                "this ffmpeg has no PulseAudio input and neither parec nor "
                "pw-record is installed")
        if recorder.endswith("parec"):
            rec = [recorder, "--device", self.source, "--format=s16le",
                   f"--rate={self.rate}", f"--channels={self.channels}"]
        else:
            rec = [recorder, "--target", self.source, "--format", "s16",
                   "--rate", str(self.rate), "--channels", str(self.channels),
                   "-"]
        enc = ["ffmpeg", "-hide_banner", "-loglevel", "warning",
               "-fflags", "nobuffer",
               "-f", "s16le", "-ar", str(self.rate),
               "-ac", str(self.channels)] + \
            channel_layout(self.channels) + ["-i", "-"] + \
            self.fmt.encoder_args + ["-"]
        debug("capture:", " ".join(shlex.quote(c) for c in rec), "|",
              " ".join(shlex.quote(c) for c in enc))
        p1 = subprocess.Popen(rec, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE)
        p2 = subprocess.Popen(enc, stdin=p1.stdout, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE)
        p1.stdout.close()
        self.procs = [p1, p2]
        self._watch_stderr(p1, os.path.basename(recorder))
        self._watch_stderr(p2, "ffmpeg")
        self.stdout = p2.stdout

    def failure_text(self) -> str:
        lines = []
        for p in self.procs:
            lines.extend(self._errbuf.get(id(p), []))
        return " | ".join(lines[-4:])

    def died_early(self) -> bool:
        return any(p.poll() not in (None, 0) for p in self.procs)

    def stop(self) -> None:
        for p in self.procs:
            try:
                p.kill()
            except Exception:
                pass
        for p in self.procs:
            try:
                p.wait(timeout=3)
            except Exception:
                pass
        self.procs = []


# --------------------------------------------------------------------------
# SSDP discovery
# --------------------------------------------------------------------------

def local_ipv4_addresses() -> list[str]:
    """Every usable local IPv4 address, so discovery covers each subnet."""
    addrs = set()
    if shutil.which("ip"):
        out = run(["ip", "-4", "-o", "addr"]).stdout or ""
        for m in re.finditer(r"inet (\d+\.\d+\.\d+\.\d+)", out):
            ip = m.group(1)
            if not ip.startswith("127."):
                addrs.add(ip)
    if not addrs:
        try:
            addrs.add(socket.gethostbyname(socket.gethostname()))
        except OSError:
            pass
    if not addrs:
        addrs.add("0.0.0.0")
    return sorted(addrs)


def ssdp_search(timeout: float = 4.0) -> list[str]:
    """Description URLs of every MediaRenderer that answers."""
    msg = ("M-SEARCH * HTTP/1.1\r\n"
           f"HOST: {SSDP_ADDR}:{SSDP_PORT}\r\n"
           'MAN: "ssdp:discover"\r\n'
           f"MX: {max(1, int(timeout))}\r\n"
           f"ST: {RENDERER_ST}\r\n\r\n").encode()

    locations: set[str] = set()
    socks = []
    for src in local_ipv4_addresses():
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 4)
            s.bind((src, 0))
            s.settimeout(0.3)
            for _ in range(2):          # datagrams get lost; ask twice
                s.sendto(msg, (SSDP_ADDR, SSDP_PORT))
            socks.append(s)
        except OSError as e:
            debug(f"SSDP unusable on {src}: {e}")
    if not socks:
        return []

    deadline = time.time() + timeout
    while time.time() < deadline:
        for s in socks:
            try:
                data, _ = s.recvfrom(65507)
            except (socket.timeout, OSError):
                continue
            for line in data.decode("utf-8", "replace").splitlines():
                if line.upper().startswith("LOCATION:"):
                    loc = line.split(":", 1)[1].strip()
                    if loc:
                        locations.add(loc)
    for s in socks:
        s.close()
    return sorted(locations)


